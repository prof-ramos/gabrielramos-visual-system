---
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'a'>;
const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname;
const normalizedHref = String(href).replace(/\/$/, '') || '/';
const exact = normalizedHref === '/' ? pathname === '/' : pathname === `${normalizedHref}/`;
const isActive = exact || (normalizedHref !== '/' && pathname.startsWith(`${normalizedHref}/`));
---
<a href={href} class:list={[className, { active: isActive }]} aria-current={exact ? 'page' : undefined} {...props}><slot /></a>
<style>
  a { display: inline-block; padding-block: .6rem; text-decoration: none; font-size: 1rem; border-bottom: 2px solid transparent; }
  a.active { border-bottom-color: var(--pink); font-weight: 600; }
  a:hover { border-bottom-color: var(--ivory); }
</style>
