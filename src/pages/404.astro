---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="pt-BR">
  <head><BaseHead title="Página não encontrada" description="Esta página não foi encontrada." /><meta name="robots" content="noindex" /></head>
  <body>
    <Header />
    <main tabindex="-1" id="conteudo" class="container">
      <div class="page-intro">
        <p class="meta">Erro 404</p>
        <h1>Essa página<br />ficou no mistério.</h1>
        <p class="lede">O endereço pode ter mudado. Encontre uma nova leitura no blog.</p>
        <div class="actions"><a class="button" href="/blog/">Ver publicações</a><a class="text-link" href="/">Voltar ao início</a></div>
      </div>
    </main>
    <Footer />
  </body>
</html>
<style>.lede { margin-bottom: 2.25rem !important; }</style>
