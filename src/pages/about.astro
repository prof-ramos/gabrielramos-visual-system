---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EditorialEngraving from '../components/EditorialEngraving.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!doctype html>
<html lang="pt-BR">
  <head><BaseHead title={`Sobre | ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main tabindex="-1" id="conteudo" class="container about">
      <div class="about-copy">
        <h1>Uma boa pergunta<br />abre caminhos.</h1>
        <p class="lede">Este é o SherlockRamos: um espaço para Direito, tecnologia, humor e curiosidade dividirem a mesma página.</p>
        <p>Por aqui, uma ideia pode começar séria e terminar com uma sobrancelha levantada. O convite é olhar de novo.</p>
        <div class="actions"><a class="button" href="/blog/">Ler as publicações</a><a class="text-link" href="/rss.xml">Acompanhar por RSS</a></div>
      </div>
      <div class="about-art"><EditorialEngraving /></div>
    </main>
    <Footer />
  </body>
</html>
<style>
  .about { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; padding-block: clamp(2.5rem, 5vw, 4.5rem) 0; }
  h1 { font-size: clamp(2.75rem, 5.2vw, 4.5rem); margin-bottom: 1.75rem; }
  .lede { max-width: 38ch; }
  .about-copy > p:not(.lede) { max-width: 46ch; margin-bottom: 2.25rem; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } h1 { font-size: clamp(2rem, 9.5vw, 4rem); } .about-art { max-width: 560px; } }
</style>
