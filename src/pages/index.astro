---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import EditorialEngraving from '../components/EditorialEngraving.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../lib/posts';
const posts = (await getPublishedPosts()).slice(0, 3);
---
<!doctype html>
<html lang="pt-BR">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main tabindex="-1" id="conteudo">
      <section class="hero container" aria-labelledby="intro">
        <div class="hero-copy">
          <h1 id="intro">E se a pergunta<br />for outra?</h1>
          <p class="lede">{SITE_DESCRIPTION}</p>
          <div class="actions"><a class="button" href="/blog/">Ler as publicações</a><a class="text-link" href="/about/">Sobre este espaço</a></div>
        </div>
        <div class="hero-art"><EditorialEngraving /></div>
      </section>
      <section class="container latest" aria-labelledby="recentes">
        <div class="section-heading"><h2 id="recentes">Publicações recentes</h2><a class="text-link" href="/blog/">Ver todas</a></div>
        <PostList posts={posts} />
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .92fr); align-items: center; gap: clamp(2rem, 5vw, 4.5rem); padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3.5rem, 7vw, 6rem); }
  h1 { font-size: clamp(2.75rem, 5.9vw, 5.25rem); margin-bottom: 1.5rem; }
  .lede { max-width: 26ch; margin-bottom: 2.25rem; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    h1 { font-size: clamp(2.125rem, 10.5vw, 4.5rem); }
    .hero-art { max-width: 560px; }
  }
</style>
