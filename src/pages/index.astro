---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import EditorialEngraving from '../components/EditorialEngraving.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../lib/posts';
const posts = (await getPublishedPosts()).slice(0, 3);
---
<!doctype html>
<html lang="pt-BR">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main tabindex="-1" id="conteudo">
      <section class="hero container" aria-labelledby="intro">
        <div class="hero-copy"><h1 id="intro">E se a pergunta<br />for outra?</h1><p>{SITE_DESCRIPTION}</p><a class="button" href="/blog/">Ler as publicações</a></div>
        <div class="hero-art"><EditorialEngraving /></div>
      </section>
      <section class="container latest" aria-labelledby="recentes">
        <div class="section-heading"><h2 id="recentes">Publicações recentes</h2><a href="/blog/">Ver todas</a></div>
        <PostList posts={posts} />
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 1rem; padding-block: 4rem 4.5rem; }
  .hero-copy { padding-bottom: 1rem; }
  h1 { font-size: clamp(3rem, 5.4vw, 4.8rem); margin-bottom: 1.5rem; }
  .hero-copy p { font-size: 1.35rem; max-width: 31ch; margin-bottom: 2rem; }
  .hero-art { margin-right: -1rem; }
  .latest { padding-top: 1rem; }
  @media (max-width: 800px) { .hero { grid-template-columns: 1fr; gap: 1.5rem; padding-block: 3rem 2.5rem; } .hero-copy { max-width: 40rem; } .hero-art { max-width: 470px; justify-self: center; margin: -1rem 0 0; } h1 { font-size: clamp(2.25rem, 12.3vw, 4.5rem); } }
</style>
