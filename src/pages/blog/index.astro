---
import { getPublishedPosts } from '../../lib/posts';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
const posts = await getPublishedPosts();
---
<!doctype html>
<html lang="pt-BR">
  <head><BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
  <body><Header /><main tabindex="-1" id="conteudo" class="container"><div class="page-intro"><h1>Publicações</h1><p>Ideias para olhar de perto. E, às vezes, pelo avesso.</p></div><PostList posts={posts} headingLevel={2} /></main><Footer /></body>
</html>
