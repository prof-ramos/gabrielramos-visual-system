---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage, example } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head><BaseHead title={title} description={description} image={heroImage} /></head>
  <body><Header /><main tabindex="-1" id="conteudo" class="container"><article class="article">
    <div class="article-rail"><a class="back-link" href="/blog/">Todas as publicações</a><p class="meta"><FormattedDate date={pubDate} />{example && <span class="example">Publicação de exemplo</span>}</p>{updatedDate && <p class="meta">Atualizado em <FormattedDate date={updatedDate} /></p>}</div>
    <header class="article-heading"><h1>{title}</h1><p class="standfirst">{description}</p></header>
    {heroImage && <Image class="hero-image" width={922} src={heroImage} alt="" />}
    <div class="prose"><slot /></div>
    <div class="article-end reading"><a href="/blog/">Voltar às publicações</a><a href="/rss.xml">Acompanhar por RSS</a></div>
  </article></main><Footer /></body>
</html>
<style>
  /* Mesma grade da lista de publicações (190px + 3rem): metadados no trilho;
     título, texto e rodapé do artigo compartilham uma única margem esquerda. */
  .article { display: grid; grid-template-columns: 190px minmax(0, 1fr); column-gap: 3rem; padding-top: 4rem; }
  .article > * { grid-column: 2; }
  .article > .article-rail { grid-column: 1; grid-row: 1 / span 4; padding-top: .9rem; }
  .back-link { display: inline-block; font-size: 1rem; margin-bottom: 2rem; }
  .meta { margin-bottom: .3rem; }
  .meta span { display: block; margin-top: .3rem; }
  .article-heading { padding-bottom: 2rem; }
  h1 { font-size: clamp(2.5rem, 5vw, 4.3rem); max-width: 22ch; }
  .standfirst { font-size: 1.4rem; max-width: 50ch; }
  .hero-image { margin-bottom: 3rem; border-radius: 4px; width: 100%; }
  .reading { margin-inline: 0; }
  .article-end { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--border); margin-top: 3rem; padding-top: 1.5rem; font-size: 1rem; }
  @media (max-width: 680px) {
    .article { grid-template-columns: 1fr; padding-top: 1.5rem; }
    .article > *, .article > .article-rail { grid-column: 1; grid-row: auto; }
    .article > .article-rail { padding: 0 0 .5rem; }
    .back-link { margin-bottom: 1.25rem; }
    .meta { display: flex; flex-wrap: wrap; gap: .5rem 1rem; }
    .meta span { margin: 0; }
    .article-heading { padding-bottom: 1.5rem; }
    .standfirst { font-size: 1.25rem; }
  }
</style>
