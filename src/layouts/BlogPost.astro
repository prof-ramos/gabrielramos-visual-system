---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
type Props = CollectionEntry<'blog'>['data'] & { minutes?: number };
const { title, description, pubDate, updatedDate, heroImage, example, minutes } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head><BaseHead title={title} description={description} image={heroImage} /></head>
  <body>
    <Header />
    <main tabindex="-1" id="conteudo" class="container">
      <article class="article rail-grid">
        <div class="article-rail">
          <a class="text-link back-link" href="/blog/">Todas as publicações</a>
          <dl class="article-meta">
            <div><dt>Publicado</dt><dd><FormattedDate date={pubDate} /></dd></div>
            {updatedDate && <div><dt>Atualizado</dt><dd><FormattedDate date={updatedDate} /></dd></div>}
            {minutes && <div><dt>Leitura</dt><dd>{minutes} min</dd></div>}
          </dl>
          {example && <p class="example">Publicação de exemplo</p>}
        </div>
        <header class="article-heading"><h1>{title}</h1><p class="lede">{description}</p></header>
        {heroImage && <Image class="hero-image" width={922} src={heroImage} alt="" />}
        <div class="prose"><slot /></div>
        <div class="article-end reading"><a class="text-link" href="/blog/">Voltar às publicações</a><a class="text-link" href="/rss.xml">Acompanhar por RSS</a></div>
      </article>
    </main>
    <Footer />
  </body>
</html>
<style>
  /* Título, texto e rodapé do artigo compartilham a mesma margem esquerda (coluna 2). */
  .article { padding-top: clamp(2rem, 5vw, 4.5rem); }
  .article > :not(.article-rail) { grid-column: 2; }
  .article-rail { grid-column: 1; grid-row: 1 / span 4; align-self: start; position: sticky; top: 2rem; font-size: .95rem; line-height: 1.5; padding-top: .6rem; }
  .back-link { display: inline-block; margin-bottom: 2rem; }
  .article-meta { margin: 0; display: grid; gap: .9rem; }
  dt { color: var(--muted); }
  dd { margin: 0; color: var(--navy); font-weight: 600; }
  .example { margin: 1.5rem 0 0; padding-top: .9rem; border-top: 1px solid var(--border); color: var(--muted); }
  .article-heading { margin-bottom: clamp(2.25rem, 4.5vw, 3.5rem); }
  h1 { font-size: clamp(2.375rem, 4.8vw, 4rem); max-width: 18ch; margin-bottom: 1.25rem; }
  .lede { max-width: 42ch; margin: 0; }
  .hero-image { margin-bottom: 3rem; border-radius: 4px; width: 100%; }
  .article-end { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem 2rem; border-top: 1px solid var(--navy); margin-top: 3.5rem; padding-top: 1.5rem; font-size: 1.0625rem; }
  @media (max-width: 860px) {
    .article > :not(.article-rail) { grid-column: 1; }
    .article-rail { grid-row: auto; position: static; padding: 0 0 1.75rem; }
    .back-link { margin-bottom: 1.5rem; }
    .article-meta { display: flex; flex-wrap: wrap; gap: .25rem 1.75rem; }
    .article-meta div { display: flex; gap: .4rem; }
    .example { margin-top: .75rem; padding: 0; border: 0; }
  }
</style>
